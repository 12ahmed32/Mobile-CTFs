Invoking a non exported native function via searching the symbols address for the function then invoking it using frida's NativeFunction wrapper :
The NativeFunction wrapper syntax : NativeFunction(address_the_function_to_invoke ,  return_type , parameter_types , parameter2-type , etc );



//Solution 


var mod = Process.findModuleByName("libFridaTen.so");

// Try export first
var addr = mod.findExportByName("getFlag");

// If not exported, search symbols
if (addr === null) {
    var sym = mod.enumerateSymbols().filter(function (s) {
        return s.name.indexOf("getFlag") !== -1;
    })[0];
    if (sym) addr = sym.address;
}

console.log("[*] getFlag @ " + addr);

 var myFunc = new NativeFunction(addr, 'pointer', ['int']);
  var result = myFunc(0x7b);
  console.log("Result: " + result.readCString());



